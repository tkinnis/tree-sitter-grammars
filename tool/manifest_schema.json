{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Language Manifest Schema",
  "description": "Schema for tree-sitter and TextMate language manifests",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_.-]+$": {
      "type": "object",
      "required": ["displayName", "scope"],
      "properties": {
        "queryOnly": {
          "type": "boolean",
          "description": "Whether this is a query-only language (no parser, only queries)",
          "default": false
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable name for the language",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "description": "Internal identifier used for lookups",
          "pattern": "^[a-zA-Z0-9_.+-]+$",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "description": "TextMate scope name",
          "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$",
          "minLength": 1
        },
        "extensions": {
          "type": "array",
          "description": "File extensions associated with this language",
          "items": {
            "type": "string",
            "pattern": "^\\.[.a-zA-Z0-9_-]+$|^[A-Z][a-zA-Z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "filenames": {
          "type": "array",
          "description": "File names without an extension associated with this language, such as Makefile",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dylib_dir": {
          "type": "string",
          "description": "Tree-sitter specific: Path to directory containing the compiled language library (relative to output/)",
          "minLength": 1
        },
        "queries_dir": {
          "type": "string",
          "description": "Tree-sitter specific: Path to directory containing query files (relative to output/)",
          "minLength": 1
        },
        "queries": {
          "type": "object",
          "description": "Tree-sitter specific: Available query types (optional)",
          "properties": {
            "highlights": {
              "type": "boolean",
              "description": "Whether highlights.scm query is available"
            },
            "injections": {
              "type": "boolean",
              "description": "Whether injections.scm query is available"
            },
            "locals": {
              "type": "boolean",
              "description": "Whether locals.scm query is available"
            },
            "tags": {
              "type": "boolean",
              "description": "Whether tags.scm query is available"
            },
            "folds": {
              "type": "boolean",
              "description": "Whether folds.scm query is available"
            },
            "indents": {
              "type": "boolean",
              "description": "Whether indents.scm query is available"
            },
            "textobjects": {
              "type": "boolean",
              "description": "Whether textobjects.scm query is available"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "description": "Tree-sitter specific: where the compiled grammar was built from; required on every entry with dylib_dir",
          "required": [
            "url",
            "commit",
            "path",
            "parser",
            "abi",
            "license"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The grammar repository",
              "pattern": "^https://"
            },
            "commit": {
              "type": "string",
              "description": "The commit the grammar was extracted at",
              "pattern": "^[0-9a-f]{40}$"
            },
            "sourceCommit": {
              "type": "string",
              "description": "For a commit on a deploy branch, the source commit it was deployed from",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "description": "The grammar directory inside the repository",
              "minLength": 1
            },
            "parser": {
              "enum": [
                "committed",
                "generated"
              ],
              "description": "Whether parser.c was committed upstream or generated by the pinned CLI"
            },
            "abi": {
              "type": "integer",
              "description": "The LANGUAGE_VERSION of the compiled parser.c, from the treeSitter.minCompatibleLanguageVersion to the treeSitter.languageVersion that build_info.json records of the runtime's api.h",
              "minimum": 1
            },
            "license": {
              "type": "string",
              "description": "The SPDX identifier of the grammar licence",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "dylib_dir"
            ]
          },
          "then": {
            "required": [
              "source"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
