function "diff"
variable.parameter "--git"
string.special.path "a/notes.txt b/notes.txt"
keyword "index"
constant "1234567"
punctuation.special ".."
constant "89abcde"
number "100644"
diff.minus "--- a/notes.txt"
string.special.path "a/notes.txt"
diff.plus "+++ b/notes.txt"
string.special.path "b/notes.txt"
attribute "@@ -1,3 +1,3 @@"
diff.minus "-old"
diff.plus "+new"
diff.minus "-"
diff.plus "+"
