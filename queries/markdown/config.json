{
  "$schema": "../../../../tool/language_config_schema.json",
  "comments": {
    "block": ["<!--", "-->"]
  },
  "lists": {
    "unorderedMarkers": ["-", "*", "+"],
    "orderedPattern": "^(\\d+)\\.\\s",
    "checkboxUnchecked": "- [ ] ",
    "checkboxChecked": "- [x] "
  },
  "brackets": [
    {"open": "(", "close": ")", "autoClose": true, "newline": false},
    {"open": "[", "close": "]", "autoClose": true, "newline": false},
    {"open": "`", "close": "`", "autoClose": true, "newline": false},
    {"open": "```", "close": "```", "autoClose": true, "newline": true}
  ]
}
