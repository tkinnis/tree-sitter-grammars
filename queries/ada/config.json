{
  "displayName": "Ada",
  "symbol": "ada",
  "scope": "source.ada",
  "extensions": [
    ".ads",
    ".adb"
  ],
  "comments": {
    "line": "--"
  },
  "brackets": [
    {
      "open": "(",
      "close": ")",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    }
  ],
  "indentation": {
    "keywordOpeners": [
      "is",
      "loop",
      "begin",
      "then",
      "else",
      "record"
    ]
  }
}
