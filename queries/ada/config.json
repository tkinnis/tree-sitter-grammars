{
  "displayName": "Ada",
  "symbol": "ada",
  "scope": "source.ada",
  "extensions": [
    ".ads",
    ".adb"
  ],
  "comments": {
    "line": "--"
  },
  "brackets": [
    {
      "open": "(",
      "close": ")",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    }
  ],
  "indentation": {
    "keywordOpeners": [
      "is",
      "loop",
      "begin",
      "then",
      "else",
      "record"
    ],
    "lineStartKeywords": [
      "procedure",
      "function",
      "package",
      "if",
      "for",
      "while",
      "declare"
    ],
    "dedentPairs": [
      {"open": "procedure", "close": "end"},
      {"open": "function", "close": "end"},
      {"open": "package", "close": "end"},
      {"open": "if", "close": "end"},
      {"open": "for", "close": "end"},
      {"open": "while", "close": "end"},
      {"open": "loop", "close": "end"},
      {"open": "begin", "close": "end"},
      {"open": "record", "close": "end"},
      {"open": "declare", "close": "end"}
    ]
  }
}
