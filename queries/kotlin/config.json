{
  "displayName": "Kotlin",
  "symbol": "kotlin",
  "scope": "source.kotlin",
  "extensions": [
    ".kt",
    ".kts"
  ],
  "comments": {
    "line": "//",
    "block": [
      "/*",
      "*/"
    ],
    "blockContinuation": " * "
  },
  "brackets": [
    {
      "open": "{",
      "close": "}",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "(",
      "close": ")",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "[",
      "close": "]",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "'",
      "close": "'",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "`",
      "close": "`",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "/**",
      "close": " */",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "/*",
      "close": "*/",
      "autoClose": true,
      "newline": true
    }
  ]
}
