      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "'",
      "close": "'",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "/**",
      "close": " */",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "/*",
      "close": "*/",
