{
  "displayName": "Commonlisp",
  "symbol": "commonlisp",
  "scope": "source.cl",
  "extensions": [
    ".cl",
    ".lisp"
  ],
  "comments": {
    "line": ";",
    "doc": ";;;",
    "block": [
      "#|",
      "|#"
    ]
  },
  "brackets": [
    {
      "open": "(",
      "close": ")",
      "autoClose": true,
      "newline": false
    }
  ],
  "indentation": {
    "blockOpeners": [],
    "lineStartBlockOpeners": [
      "("
    ]
  }
}
