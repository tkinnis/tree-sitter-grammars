{
  "displayName": "HTML Tags",
  "scope": "html.tags",
  "extensions": [],
  "queryOnly": true,
  "comments": {
    "block": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "'",
      "close": "'",
      "autoClose": true,
      "newline": false
    }
  ]
}
