{
  "displayName": "XML",
  "symbol": "xml",
  "scope": "source.xml",
  "extensions": [
    ".xml",
    ".svg",
    ".xsd",
    ".xslt",
    ".xsl",
    ".rng"
  ],
  "comments": {
    "block": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    {
      "open": "<",
      "close": ">",
      "autoClose": false,
      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "'",
      "close": "'",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "<!--",
      "close": " -->",
      "autoClose": true,
      "newline": true
    }
  ],
  "indentation": {
    "blockOpeners": [
      "{",
      ">"
    ]
  }
}
