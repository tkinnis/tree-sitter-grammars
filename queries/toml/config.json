{
  "displayName": "TOML",
  "symbol": "toml",
  "scope": "source.toml",
  "extensions": [
    ".toml"
  ],
  "comments": {
    "line": "#"
  },
  "brackets": [
    {
      "open": "{",
      "close": "}",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "[",
      "close": "]",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "'",
      "close": "'",
      "autoClose": true,
      "newline": false
    }
  ]
}
