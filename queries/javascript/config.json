{
  "displayName": "JavaScript",
  "symbol": "javascript",
  "scope": "source.js",
  "extensions": [
    ".js",
    ".mjs",
    ".cjs",
    ".jsx"
  ],
  "comments": {
    "line": "//",
    "block": [
      "/*",
      "*/"
    ],
    "blockContinuation": " * "
  },
  "brackets": [
    {
      "open": "{",
      "close": "}",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "(",
      "close": ")",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "[",
      "close": "]",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "'",
      "close": "'",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "`",
      "close": "`",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "/**",
      "close": " */",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "/*",
      "close": "*/",
      "autoClose": true,
      "newline": true
    }
  ]
}
