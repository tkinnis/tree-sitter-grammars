{
  "displayName": "Rust",
  "symbol": "rust",
  "scope": "source.rust",
  "extensions": [
    ".rs"
  ],
  "comments": {
    "line": "//",
    "doc": "///",
    "block": [
      "/*",
      "*/"
    ],
    "blockContinuation": " * "
  },
  "brackets": [
    {
      "open": "{",
      "close": "}",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "(",
      "close": ")",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "[",
      "close": "]",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "\"",
      "close": "\"",
      "autoClose": true,
      "newline": false
    },
    {
      "open": "/**",
      "close": " */",
      "autoClose": true,
      "newline": true
    },
    {
      "open": "/*",
      "close": "*/",
      "autoClose": true,
      "newline": true
    }
  ]
}
