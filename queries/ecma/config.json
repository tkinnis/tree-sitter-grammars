{
  "displayName": "ECMAScript",
  "scope": "source.ecma",
  "extensions": [],
  "queryOnly": true,
  "comments": {
    "line": "//",
    "block": ["/*", "*/"],
    "blockContinuation": " * "
  },
  "brackets": [
    {"open": "{", "close": "}", "autoClose": true, "newline": true},
    {"open": "(", "close": ")", "autoClose": true, "newline": false},
    {"open": "[", "close": "]", "autoClose": true, "newline": false},
    {"open": "\"", "close": "\"", "autoClose": true, "newline": false},
    {"open": "'", "close": "'", "autoClose": true, "newline": false},
    {"open": "`", "close": "`", "autoClose": true, "newline": false},
    {"open": "/**", "close": " */", "autoClose": true, "newline": true},
    {"open": "/*", "close": "*/", "autoClose": true, "newline": true}
  ]
}
